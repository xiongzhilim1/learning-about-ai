#!/usr/bin/env node
// Verification CLI: one isolated vite (dev, or build + preview) + headless Chrome per run, driven via Playwright over CDP.
// Usage is printed by `scripts/site help`. The verify skill lives in .claude/skills/verify-learning-about-ai/.
import { spawn, spawnSync, execFileSync } from "node:child_process";
import { createHash } from "node:crypto";
import fs from "node:fs";
import net from "node:net";
import path from "node:path";
import { fileURLToPath } from "node:url";
import { chromium } from "playwright-core";

const REPO = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
const RUNS = path.join(REPO, ".verify", "runs");
const EVIDENCE = path.join(REPO, ".verify", "evidence");
const CHROME = "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome";

const USAGE = `scripts/site <command> [args]

Run lifecycle (each run = own vite port, own Chrome profile + CDP port, own evidence dir):
  launch [--run ID] [--preview]  start vite + headless Chrome; prints "export SITE_RUN=<id>"
                                 --preview: vite build into the run dir, then vite preview (production bundle,
                                 code-split chunks, no dev-only hooks); the build is frozen at launch
  doctor                         read-only health check of the selected run
  stop                           kill only this run's processes; evidence is kept

Hands and eyes (operate on the run's single tab):
  open <path>                    navigate, wait for load; prints url, title, console errors
  click <role> <name|/regex/>    click by ARIA role + accessible name
  expect-text <text|/regex/> [--absent] [--timeout ms]
                                 wait for visible text (or its absence); exit 1 on failure
  expect-aria </regex/>          match the page's ARIA snapshot (multi-line) against a regex;
                                 use it to pin structure, e.g. "the line after X is Y"; exit 1 on failure
  page-state                     url, title, viewport
  viewport <W>x<H> | reset       set the page viewport (e.g. 390x844) until reset or stop; it persists
                                 across commands (a held CDP session keeps the override); reset = 1280x813
  screenshot <name> [--full]     PNG into the evidence dir
  assets [--expect /regex/] [--absent] [--timeout ms] [--save name]
                                 JS/CSS the current document fetched, each tagged initial (in index.html)
                                 or lazy (fetched later); --expect waits for a lazy asset to match, exit 1
                                 if none; with --absent, exit 1 if any loaded asset matches
  snapshot <name>                ARIA snapshot (YAML) of the page into the evidence dir

Canvas instruments (BrainMesh pages only: /digital-brain, /design):
  brain-state [--save name] [--expect-frames N] [--expect-contexts N]
                                 canvas + WebGL2 + window.__brain.state + live WebGL2 contexts (after GC);
                                 exit 1 if frames != N or live contexts != N
  cpu-trace <seconds> [--scroll] [--expect-rest]
                                 Chrome trace (open in Perfetto / DevTools); prints frame delta;
                                 --expect-rest exits 1 if any frame rendered during the trace
  heap-snapshot <name>           GC, then .heapsnapshot + JS heap used

Run selection: SITE_RUN=<id>, else the only live run. Evidence: .verify/evidence/<id>/
Every command appends "trigger -> result" to .verify/evidence/<id>/commands.log.`;

const [cmd, ...args] = process.argv.slice(2);
const flag = (name) => args.includes(name);
const opt = (name, dflt) => {
  const i = args.indexOf(name);
  return i >= 0 ? args[i + 1] : dflt;
};
const positional = args.filter((a, i) => !a.startsWith("--") && !(i > 0 && ["--run", "--timeout", "--save", "--expect", "--expect-frames", "--expect-contexts"].includes(args[i - 1])));

const alive = (pid) => {
  try {
    process.kill(pid, 0);
    return true;
  } catch {
    return false;
  }
};
const freePort = () =>
  new Promise((res) => {
    const s = net.createServer().listen(0, "127.0.0.1", () => {
      const { port } = s.address();
      s.close(() => res(port));
    });
  });
const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
const toName = (s) => (s.startsWith("/") && s.lastIndexOf("/") > 0 ? new RegExp(s.slice(1, s.lastIndexOf("/")), s.slice(s.lastIndexOf("/") + 1)) : s);

function liveRuns() {
  if (!fs.existsSync(RUNS)) return [];
  return fs
    .readdirSync(RUNS)
    .map((id) => path.join(RUNS, id, "state.json"))
    .filter((f) => fs.existsSync(f))
    .map((f) => JSON.parse(fs.readFileSync(f, "utf8")))
    .filter((s) => alive(s.vitePid));
}

function selectRun() {
  const runs = liveRuns();
  if (process.env.SITE_RUN) {
    const r = runs.find((s) => s.run === process.env.SITE_RUN);
    if (!r) die(`run ${process.env.SITE_RUN} is not live (live: ${runs.map((s) => s.run).join(", ") || "none"})`);
    return r;
  }
  if (runs.length === 1) return runs[0];
  die(runs.length ? `several live runs (${runs.map((s) => s.run).join(", ")}); set SITE_RUN` : "no live run; scripts/site launch");
}

function die(msg) {
  console.error(msg);
  process.exit(1);
}

function record(run, line) {
  fs.mkdirSync(path.join(EVIDENCE, run.run), { recursive: true });
  fs.appendFileSync(path.join(EVIDENCE, run.run, "commands.log"), `${new Date().toISOString()}  ${line}\n`);
}

async function withPage(run, fn) {
  const browser = await chromium.connectOverCDP(`http://127.0.0.1:${run.cdpPort}`);
  try {
    const ctx = browser.contexts()[0];
    const page = ctx.pages()[0] ?? (await ctx.newPage());
    return await fn(page, ctx);
  } finally {
    await browser.close(); // disconnects only; the run's Chrome keeps running
  }
}

async function launch() {
  const run = opt("--run", new Date().toISOString().replace(/[-:]/g, "").replace("T", "-").slice(0, 15));
  const dir = path.join(RUNS, run);
  if (fs.existsSync(path.join(dir, "state.json"))) die(`run ${run} already exists`);
  fs.mkdirSync(dir, { recursive: true });
  fs.mkdirSync(path.join(EVIDENCE, run), { recursive: true });
  const [vitePort, cdpPort] = [await freePort(), await freePort()];
  const url = `http://127.0.0.1:${vitePort}`;

  const preview = flag("--preview");
  const distDir = path.join(dir, "dist");
  let build;
  if (preview) {
    build = { commit: git("rev-parse", "--short", "HEAD"), treeHash: treeHash(), changed: changedFiles() };
    console.log(`building (vite build -> ${path.relative(REPO, distDir)}) ...`);
    const t0 = Date.now();
    const out = spawnSync(path.join(REPO, "node_modules/.bin/vite"), ["build", "--outDir", distDir, "--emptyOutDir"], { cwd: REPO, encoding: "utf8" });
    fs.writeFileSync(path.join(dir, "build.log"), (out.stdout ?? "") + (out.stderr ?? ""));
    if (out.status !== 0) die(`vite build failed:\n${fs.readFileSync(path.join(dir, "build.log"), "utf8")}`);
    build.seconds = Math.round((Date.now() - t0) / 100) / 10;
  }
  const viteArgs = preview
    ? ["preview", "--outDir", distDir, "--host", "127.0.0.1", "--port", String(vitePort), "--strictPort"]
    : ["--host", "127.0.0.1", "--port", String(vitePort), "--strictPort"];
  const viteLog = fs.openSync(path.join(dir, "vite.log"), "a");
  const vite = spawn(path.join(REPO, "node_modules/.bin/vite"), viteArgs, {
    cwd: REPO,
    detached: true,
    stdio: ["ignore", viteLog, viteLog],
  });
  vite.unref();
  const chrome = spawn(
    CHROME,
    ["--headless=new", `--remote-debugging-port=${cdpPort}`, `--user-data-dir=${path.join(dir, "chrome")}`, "--window-size=1280,900", "--no-first-run", "--no-default-browser-check", "--enable-unsafe-swiftshader", "--disable-features=BackForwardCache", "about:blank"],
    { detached: true, stdio: "ignore" },
  );
  chrome.unref();
  const state = { run, url, vitePort, vitePid: vite.pid, cdpPort, chromePid: chrome.pid, startedAt: new Date().toISOString(), commit: git("rev-parse", "--short", "HEAD") };
  if (preview) Object.assign(state, { mode: "preview", distDir, build });
  fs.writeFileSync(path.join(dir, "state.json"), JSON.stringify(state, null, 2));

  // Ready means usable: the app entry transforms (dev) or the built entry chunk is served (preview), and Chrome answers CDP.
  for (let i = 0; i < 60; i++) {
    const viteOk = preview ? (await builtEntry(url)).ok : await fetch(`${url}/src/main.tsx`).then((r) => r.ok).catch(() => false);
    const cdpOk = await fetch(`http://127.0.0.1:${cdpPort}/json/version`).then((r) => r.ok).catch(() => false);
    if (viteOk && cdpOk) {
      record(state, `launch${preview ? " --preview" : ""} -> ready ${url} cdp:${cdpPort} commit:${state.commit}${preview ? ` build:${build.seconds}s${build.changed ? ` dirty(${build.changed})` : ""}` : ""}`);
      console.log(`ready: ${url}  (vite ${preview ? "preview " : ""}pid ${vite.pid}, chrome pid ${chrome.pid}, cdp ${cdpPort})`);
      console.log(`evidence: ${path.join(EVIDENCE, run)}`);
      console.log(`export SITE_RUN=${run}`);
      return;
    }
    if (!alive(vite.pid)) die(`vite exited:\n${fs.readFileSync(path.join(dir, "vite.log"), "utf8")}`);
    await sleep(500);
  }
  die(`not ready after 30s; see ${path.join(dir, "vite.log")} (run scripts/site stop with SITE_RUN=${run})`);
}

function git(...a) {
  return execFileSync("git", ["-C", REPO, ...a], { encoding: "utf8" }).trim();
}

const changedFiles = () => git("status", "--porcelain", "--untracked-files=no").split("\n").filter(Boolean).length;
const treeHash = () => createHash("sha1").update(git("rev-parse", "HEAD")).update(git("diff", "HEAD")).digest("hex").slice(0, 12);

// The hashed entry chunk index.html points at, and whether the server returns it as JS.
async function builtEntry(url) {
  const html = await fetch(`${url}/`).then((r) => r.text()).catch(() => "");
  const src = /<script[^>]+src="(\/assets\/index-[^"]+\.js)"/.exec(html)?.[1];
  if (!src) return { ok: false };
  const ok = await fetch(url + src).then((r) => r.ok && /javascript/.test(r.headers.get("content-type") ?? "")).catch(() => false);
  return { ok, src };
}

async function doctor(run) {
  const checks = [];
  const check = (ok, label) => checks.push(`${ok ? "ok  " : "FAIL"} ${label}`) && ok;
  check(alive(run.vitePid), `vite pid ${run.vitePid} alive`);
  let listener = "";
  try {
    listener = execFileSync("lsof", ["-nP", `-iTCP:${run.vitePort}`, "-sTCP:LISTEN", "-t"], { encoding: "utf8" }).trim().split("\n")[0];
  } catch {}
  check(listener === String(run.vitePid), `port ${run.vitePort} owned by this run's vite (listener: ${listener || "none"})`);
  let cwd = "";
  try {
    cwd = execFileSync("lsof", ["-a", "-p", String(run.vitePid), "-d", "cwd", "-Fn"], { encoding: "utf8" }).split("\n").find((l) => l.startsWith("n"))?.slice(1) ?? "";
  } catch {}
  check(cwd === REPO, `vite serves this checkout (${cwd || "unknown"})`);
  const index = await fetch(`${run.url}/`).then((r) => r.text()).catch(() => "");
  check(index.includes('<div id="root">'), "index.html served");
  if (run.mode === "preview") {
    const entry = await builtEntry(run.url);
    check(entry.ok, `production bundle served (entry ${entry.src ?? "none"})`);
    const src = await fetch(`${run.url}/src/main.tsx`).then((r) => r.headers.get("content-type") ?? "").catch(() => "");
    check(!/javascript/.test(src), `preview server, not dev (/src/main.tsx not served as a module: ${src || "no response"})`);
  } else check(await fetch(`${run.url}/src/main.tsx`).then((r) => r.ok).catch(() => false), "/src/main.tsx transforms");
  const deep = await fetch(`${run.url}/ai/context-engineering/selector`).then((r) => r.text()).catch(() => "");
  check(deep.includes('<div id="root">'), "deep link falls back to index.html");
  check(alive(run.chromePid) && (await fetch(`http://127.0.0.1:${run.cdpPort}/json/version`).then((r) => r.ok).catch(() => false)), `chrome pid ${run.chromePid} answers CDP on ${run.cdpPort}`);
  const head = git("rev-parse", "--short", "HEAD");
  const changed = changedFiles();
  const dirty = changed ? ` dirty (${changed} uncommitted file${changed === 1 ? "" : "s"} being served)` : "";
  if (run.mode === "preview") check(treeHash() === run.build.treeHash, "build matches the current tree (HEAD and uncommitted diff unchanged since launch)");
  checks.push(`info commit ${head}; launched at ${run.commit}`);
  if (run.mode === "preview") {
    const b = run.build;
    checks.push(`info mode preview (production build of ${b.commit}${b.changed ? ` + ${b.changed} uncommitted file${b.changed === 1 ? "" : "s"}` : ""}, built in ${b.seconds}s; edits after launch are not served)`);
    checks.push(`info tree ${b.changed ? `dirty (${b.changed} uncommitted file${b.changed === 1 ? "" : "s"} in the build)` : "clean"}`);
  } else checks.push(`info tree ${changed ? dirty.trim() : "clean"}`);
  checks.push(`info viewport ${run.holderPid && alive(run.holderPid) ? `${run.viewport} (held by pid ${run.holderPid})` : "default 1280x813"}`);
  checks.push(`info run ${run.run}  url ${run.url}  evidence ${path.join(EVIDENCE, run.run)}`);
  console.log(checks.join("\n"));
  const failed = checks.some((c) => c.startsWith("FAIL"));
  record(run, `doctor -> ${failed ? "FAIL" : "ok"}${run.mode === "preview" ? " mode:preview" : ""} commit:${head}${(run.mode === "preview" ? run.build.changed : changed) ? " dirty" : ""}`);
  if (failed) process.exit(1);
}

// Emulation overrides die with the CDP session that set them, and every command disconnects.
// So `viewport` spawns this holder: a detached process that keeps one session open with the override.
// (Resizing the window would persist too, but headless Chrome clamps windows to >= 500px wide.)
async function holdViewport(run, width, height) {
  const browser = await chromium.connectOverCDP(`http://127.0.0.1:${run.cdpPort}`);
  browser.on("disconnected", () => process.exit(0));
  const ctx = browser.contexts()[0];
  const page = ctx.pages()[0] ?? (await ctx.newPage());
  const cdp = await ctx.newCDPSession(page);
  await cdp.send("Emulation.setDeviceMetricsOverride", { width, height, deviceScaleFactor: 1, mobile: false });
  setInterval(() => {}, 1 << 30);
}

async function viewport(run) {
  const arg = positional[0];
  const m = /^(\d+)x(\d+)$/.exec(arg ?? "");
  if (arg !== "reset" && !m) die("usage: viewport <W>x<H> | reset");
  if (run.holderPid && alive(run.holderPid)) process.kill(run.holderPid);
  const want = m ? { width: Number(m[1]), height: Number(m[2]) } : { width: 1280, height: 813 };
  const stateFile = path.join(RUNS, run.run, "state.json");
  const next = { ...run, holderPid: undefined, viewport: undefined };
  if (m) {
    const holder = spawn(process.execPath, [fileURLToPath(import.meta.url), "_hold-viewport", m[1], m[2]], { detached: true, stdio: "ignore", env: { ...process.env, SITE_RUN: run.run } });
    holder.unref();
    Object.assign(next, { holderPid: holder.pid, viewport: arg });
  }
  fs.writeFileSync(stateFile, JSON.stringify(next, null, 2));
  let got;
  for (let i = 0; i < 25; i++) {
    got = await withPage(run, (page) => page.evaluate(() => ({ width: innerWidth, height: innerHeight })));
    if (got.width === want.width && got.height === want.height) break;
    await sleep(200);
  }
  const ok = got.width === want.width && got.height === want.height;
  const out = `${ok ? "ok" : "FAIL"} viewport ${JSON.stringify(got)}${m ? ` held by pid ${next.holderPid}` : " (default)"}`;
  console.log(out);
  record(run, `viewport ${arg} -> ${out}`);
  if (!ok) process.exit(1);
}

async function main() {
  if (!cmd || cmd === "help" || cmd === "--help") return console.log(USAGE);
  if (cmd === "launch") return launch();
  const run = selectRun();
  if (cmd === "_hold-viewport") return holdViewport(run, Number(positional[0]), Number(positional[1]));

  switch (cmd) {
    case "doctor":
      return doctor(run);

    case "stop": {
      for (const pid of [run.holderPid, run.chromePid, run.vitePid]) if (pid && alive(pid)) process.kill(pid);
      record(run, "stop -> killed this run's vite + chrome");
      await sleep(500);
      fs.rmSync(path.join(RUNS, run.run), { recursive: true, force: true });
      console.log(`stopped run ${run.run}; evidence kept at ${path.join(EVIDENCE, run.run)}`);
      return;
    }

    case "open": {
      const target = positional[0] ?? "/";
      return withPage(run, async (page) => {
        const errors = [];
        // favicon.ico 404s on every page (no favicon shipped); everything else counts.
        page.on("console", (m) => m.type() === "error" && !m.location().url.endsWith("/favicon.ico") && errors.push(`${m.text()} @ ${m.location().url}`));
        page.on("pageerror", (e) => errors.push(e.message));
        await page.goto(run.url + target, { waitUntil: "load" });
        await page.waitForLoadState("networkidle").catch(() => {});
        const out = `url ${page.url().replace(run.url, "")}  title "${await page.title()}"  console-errors ${errors.length}`;
        console.log(out + (errors.length ? "\n  " + errors.join("\n  ") : ""));
        record(run, `open ${target} -> ${out}`);
      });
    }

    case "click": {
      const [role, name] = positional;
      if (!role || !name) die("usage: click <role> <name|/regex/>");
      return withPage(run, async (page) => {
        const loc = page.getByRole(role, { name: toName(name), exact: !name.startsWith("/") });
        const n = await loc.count();
        if (n !== 1) {
          record(run, `click ${role} "${name}" -> FAIL matched ${n}`);
          die(`click: ${role} "${name}" matched ${n} elements (need exactly 1)`);
        }
        await loc.click();
        await page.waitForTimeout(150);
        const out = `clicked ${role} "${name}"  url ${page.url().replace(run.url, "")}`;
        console.log(out);
        record(run, `click ${role} "${name}" -> ${out}`);
      });
    }

    case "expect-text": {
      const text = positional[0];
      if (!text) die("usage: expect-text <text|/regex/> [--absent]");
      const timeout = Number(opt("--timeout", 5000));
      return withPage(run, async (page) => {
        const loc = page.getByText(toName(text), { exact: false }).filter({ visible: true }).first();
        const absent = flag("--absent");
        const ok = await loc
          .waitFor({ state: absent ? "detached" : "visible", timeout })
          .then(() => true)
          .catch(async () => absent && (await page.getByText(toName(text)).filter({ visible: true }).count()) === 0);
        const out = `${ok ? "PASS" : "FAIL"} text ${absent ? "absent" : "visible"}: ${text}`;
        console.log(out);
        record(run, `expect-text ${text}${absent ? " --absent" : ""} -> ${out}`);
        if (!ok) process.exit(1);
      });
    }

    case "expect-aria": {
      const pattern = positional[0];
      if (!pattern || !pattern.startsWith("/")) die('usage: expect-aria "/regex/"');
      return withPage(run, async (page) => {
        const aria = await page.locator("body").ariaSnapshot();
        const ok = toName(pattern).test(aria);
        const out = `${ok ? "PASS" : "FAIL"} aria matches: ${pattern}`;
        console.log(out);
        record(run, `expect-aria ${pattern} -> ${out}`);
        if (!ok) process.exit(1);
      });
    }

    case "page-state":
      return withPage(run, async (page) => {
        const out = `url ${page.url().replace(run.url, "")}  title "${await page.title()}"  viewport ${JSON.stringify(page.viewportSize() ?? (await page.evaluate(() => ({ width: innerWidth, height: innerHeight }))))}`;
        console.log(out);
        record(run, `page-state -> ${out}`);
      });

    case "viewport":
      return viewport(run);

    case "screenshot":
    case "snapshot": {
      const name = positional[0];
      if (!name) die(`usage: ${cmd} <name>`);
      return withPage(run, async (page) => {
        const file = path.join(EVIDENCE, run.run, cmd === "screenshot" ? `${name}.png` : `${name}.aria.yml`);
        if (cmd === "screenshot") await page.screenshot({ path: file, fullPage: flag("--full") });
        else fs.writeFileSync(file, `# ${page.url()}  "${await page.title()}"\n${await page.locator("body").ariaSnapshot()}\n`);
        console.log(file);
        record(run, `${cmd} ${name} -> ${path.relative(REPO, file)}`);
      });
    }

    case "assets":
      return assets(run);

    case "brain-state":
      return withPage(run, async (page) => {
        const s = await brainState(page);
        const json = JSON.stringify(s, null, 2);
        console.log(json);
        const save = opt("--save");
        if (save) fs.writeFileSync(path.join(EVIDENCE, run.run, `${save}.brain.json`), json + "\n");
        const checks = [];
        const wantFrames = opt("--expect-frames");
        if (wantFrames !== undefined)
          checks.push(!s.hook ? `FAIL frames unknown: no window.__brain (dev-only; production builds strip it)` : s.state.frames === Number(wantFrames) ? `PASS frames == ${wantFrames}` : `FAIL frames ${s.state.frames} != ${wantFrames}`);
        const wantCtx = opt("--expect-contexts");
        if (wantCtx !== undefined) checks.push(s.liveWebGLContexts === Number(wantCtx) ? `PASS live contexts == ${wantCtx}` : `FAIL live contexts ${s.liveWebGLContexts} != ${wantCtx}`);
        const verdict = checks.length ? `  ${checks.join("  ")}` : "";
        if (verdict) console.log(verdict.trim());
        record(run, `brain-state -> canvas:${s.canvas} webgl2:${s.webgl2} hook:${s.hook} frames:${s.state?.frames ?? "-"} live-contexts:${s.liveWebGLContexts}${save ? ` saved ${save}.brain.json` : ""}${verdict}`);
        if (verdict.includes("FAIL")) process.exit(1);
      });

    case "cpu-trace": {
      const seconds = Number(positional[0] ?? 3);
      return withPage(run, async (page) => {
        const before = await brainState(page);
        if (!before.canvas) die("cpu-trace: no BrainMesh canvas on this page (open /digital-brain or /design first)");
        const name = `cpu-trace-${Date.now()}`;
        const file = path.join(EVIDENCE, run.run, `${name}.json`);
        await page.context().browser().startTracing(page, { path: file, categories: ["devtools.timeline", "disabled-by-default-devtools.timeline.frame", "gpu", "v8.execute"] });
        const t0 = Date.now();
        if (flag("--scroll")) {
          while (Date.now() - t0 < seconds * 1000) {
            await page.mouse.wheel(0, 400);
            await page.waitForTimeout(100);
          }
        } else await page.waitForTimeout(seconds * 1000);
        await page.context().browser().stopTracing();
        const after = await brainState(page);
        const rested = before.state && after.state && before.state.frames === after.state.frames;
        const verdict = !flag("--expect-rest") ? "" : !before.hook ? "  FAIL rest unknown: no window.__brain (dev-only; production builds strip it)" : rested ? "  PASS at rest" : "  FAIL frames rendered during trace";
        const out = `${path.relative(REPO, file)}  ${seconds}s${flag("--scroll") ? " scrolling" : " idle"}  brain frames ${before.state?.frames ?? "?"} -> ${after.state?.frames ?? "?"}  draw calls ${after.state?.renderer.calls ?? "?"}${verdict}`;
        console.log(out);
        record(run, `cpu-trace ${seconds}${flag("--scroll") ? " --scroll" : ""}${flag("--expect-rest") ? " --expect-rest" : ""} -> ${out}`);
        if (verdict.includes("FAIL")) process.exit(1);
      });
    }

    case "heap-snapshot": {
      const name = positional[0];
      if (!name) die("usage: heap-snapshot <name>");
      return withPage(run, async (page) => {
        const s = await brainState(page);
        if (!s.canvas) die("heap-snapshot: no BrainMesh canvas on this page (open /digital-brain or /design first)");
        const cdp = await page.context().newCDPSession(page);
        await cdp.send("HeapProfiler.enable");
        await cdp.send("HeapProfiler.collectGarbage");
        const { usedSize } = await cdp.send("Runtime.getHeapUsage");
        const file = path.join(EVIDENCE, run.run, `${name}.heapsnapshot`);
        const out = fs.createWriteStream(file);
        cdp.on("HeapProfiler.addHeapSnapshotChunk", ({ chunk }) => out.write(chunk));
        await cdp.send("HeapProfiler.takeHeapSnapshot", { reportProgress: false });
        await new Promise((r) => out.end(r));
        const line = `${path.relative(REPO, file)}  js-heap-used ${(usedSize / 1e6).toFixed(1)}MB  geometries ${s.state?.renderer.geometries ?? "?"}  textures ${s.state?.renderer.textures ?? "?"}`;
        console.log(line);
        record(run, `heap-snapshot ${name} -> ${line}`);
      });
    }

    default:
      die(`unknown command: ${cmd}\n\n${USAGE}`);
  }
}

// Resource Timing is per document: in-app navigation keeps the list, `open` resets it.
async function assets(run) {
  const html = await fetch(`${run.url}/`).then((r) => r.text()).catch(() => "");
  const initial = new Set([...html.matchAll(/(?:src|href)="([^"]+)"/g)].map((m) => m[1]));
  const want = opt("--expect");
  const re = want ? toName(want) : null;
  if (want && !(re instanceof RegExp)) die("assets: --expect takes /regex/");
  const absent = flag("--absent");
  const timeout = Number(opt("--timeout", 5000));
  return withPage(run, async (page) => {
    const read = async () =>
      (
        await page.evaluate(() =>
          performance
            .getEntriesByType("resource")
            .map((e) => ({ path: new URL(e.name).pathname, at: Math.round(e.startTime) }))
            .filter((e) => /\.(m?js|tsx?|jsx|css)$/.test(e.path)),
        )
      ).map((e) => ({ ...e, load: initial.has(e.path) ? "initial" : "lazy" }));
    const matches = (rows) => rows.filter((r) => re.test(r.path) && (absent || r.load === "lazy"));
    let rows = await read();
    for (const t0 = Date.now(); re && !absent && !matches(rows).length && Date.now() - t0 < timeout; rows = await read()) await sleep(200);
    const lazy = rows.filter((r) => r.load === "lazy").length;
    const summary = `url ${page.url().replace(run.url, "")}  ${rows.length} js/css (${rows.length - lazy} initial, ${lazy} lazy)  mode ${run.mode ?? "dev"}`;
    console.log([summary, ...rows.map((r) => `  ${r.load.padEnd(7)} +${String(r.at).padStart(5)}ms  ${r.path}`)].join("\n"));
    if (run.mode !== "preview") console.log("note: the dev server serves unbundled modules; built chunks exist only with launch --preview");
    const save = opt("--save");
    if (save) fs.writeFileSync(path.join(EVIDENCE, run.run, `${save}.assets.json`), JSON.stringify({ url: page.url(), mode: run.mode ?? "dev", assets: rows }, null, 2) + "\n");
    let verdict = "";
    if (re) {
      const hits = matches(rows);
      const ok = absent ? hits.length === 0 : hits.length > 0;
      verdict = `${ok ? "PASS" : "FAIL"} ${absent ? "no loaded asset matches" : "lazy asset matches"} ${want}${hits.length ? `: ${hits.map((h) => h.path).join(", ")}` : ""}`;
      console.log(verdict);
    }
    record(run, `assets${want ? ` --expect ${want}${absent ? " --absent" : ""}` : ""} -> ${summary}${save ? ` saved ${save}.assets.json` : ""}${verdict ? `  ${verdict}` : ""}`);
    if (verdict.startsWith("FAIL")) process.exit(1);
  });
}

// Live WebGL2 contexts in the page heap after a forced GC. Each mounted R3F canvas holds one;
// the FixedCanvas gate's probe holds a transient one. A count that grows per mount is a leak.
async function liveContexts(page) {
  const cdp = await page.context().newCDPSession(page);
  await cdp.send("HeapProfiler.enable");
  await cdp.send("HeapProfiler.collectGarbage");
  const proto = await cdp.send("Runtime.evaluate", { expression: "WebGL2RenderingContext.prototype" });
  const { objects } = await cdp.send("Runtime.queryObjects", { prototypeObjectId: proto.result.objectId });
  const { result } = await cdp.send("Runtime.callFunctionOn", { objectId: objects.objectId, functionDeclaration: "function () { return this.length; }", returnByValue: true });
  await cdp.detach();
  return result.value;
}

async function brainState(page) {
  const contexts = await liveContexts(page);
  const s = await page.evaluate(() => {
    const canvas = document.querySelectorAll("canvas").length;
    let webgl2 = false;
    try {
      webgl2 = !!document.createElement("canvas").getContext("webgl2");
    } catch {}
    const b = window.__brain;
    return { canvas, webgl2, hook: !!b, state: b ? b.state : null };
  });
  return { ...s, liveWebGLContexts: contexts };
}

main().catch((e) => die(e.stack ?? String(e)));
